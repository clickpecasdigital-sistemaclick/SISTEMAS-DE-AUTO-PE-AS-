<Window x:Class="AutoPecasERP.Desktop.Views.CentroFinanceiroWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Centro Financeiro" Width="1320" Height="800" WindowStartupLocation="CenterOwner" Background="#F4F6F8"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Centro Financeiro" FontSize="28" FontWeight="Bold" Foreground="#123B52"/><Grid Grid.Row="1" Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="A RECEBER"/><TextBlock x:Name="ReceberTxt" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="1" Background="White" Padding="14" Margin="8,0"><StackPanel><TextBlock Text="A PAGAR"/><TextBlock x:Name="PagarTxt" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="2" Background="White" Padding="14" Margin="8,0"><StackPanel><TextBlock Text="ATRASADO"/><TextBlock x:Name="AtrasadoTxt" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="3" Background="White" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="SALDO CAIXA"/><TextBlock x:Name="CaixaTxt" FontSize="22" FontWeight="Bold"/></StackPanel></Border></Grid><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><ComboBox x:Name="FiltroTipo" Width="150" Height="36" SelectionChanged="Filtro_Changed"><ComboBoxItem Content="TODOS"/><ComboBoxItem Content="RECEBER"/><ComboBoxItem Content="PAGAR"/><ComboBoxItem Content="ATRASADOS"/></ComboBox><TextBox x:Name="BuscaBox" Width="300" Height="36" Margin="10,0" ToolTip="Pessoa ou descrição" TextChanged="Busca_Changed"/><Button Content="Atualizar" Width="100" Click="Atualizar_Click"/></StackPanel><DataGrid x:Name="Grid" Grid.Row="1" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="90"/><DataGridTextColumn Header="Pessoa" Binding="{Binding Pessoa}" Width="220"/><DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/><DataGridTextColumn Header="Vencimento" Binding="{Binding Vencimento,StringFormat=dd/MM/yyyy}" Width="110"/><DataGridTextColumn Header="Valor" Binding="{Binding Valor,StringFormat=C}" Width="110"/><DataGridTextColumn Header="Pago" Binding="{Binding Pago,StringFormat=C}" Width="110"/><DataGridTextColumn Header="Saldo" Binding="{Binding Saldo,StringFormat=C}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></Grid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Abrir Caixa" Width="105" Click="AbrirCaixa_Click"/><Button Content="Suprimento" Width="105" Margin="8,0" Click="Suprimento_Click"/><Button Content="Sangria" Width="105" Click="Sangria_Click"/><Button Content="Baixar título" Width="120" Margin="8,0" Click="Baixar_Click"/><Button Content="Fechar Caixa" Width="115" Click="FecharCaixa_Click"/></StackPanel></Grid></Window>