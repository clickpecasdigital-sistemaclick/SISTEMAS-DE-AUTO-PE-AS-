<Window x:Class="AutoPecasERP.Desktop.Views.FornecedoresWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fornecedores" Width="1100" Height="650" WindowStartupLocation="CenterOwner"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Fornecedores" FontSize="28" FontWeight="Bold"/><DataGrid x:Name="GridDados" Grid.Row="1" Margin="0,15" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" Width="2*"/><DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="*"/><DataGridTextColumn Header="Contato" Binding="{Binding Contato}" Width="*"/><DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="*"/><DataGridTextColumn Header="Cidade" Binding="{Binding Cidade}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="Empresa" Width="230" Margin="4"/><TextBox x:Name="Cnpj" Width="160" Margin="4"/><TextBox x:Name="Telefone" Width="140" Margin="4"/><Button Content="Adicionar" Width="100" Margin="4" Click="Adicionar_Click"/></StackPanel></Grid></Window>