<Window x:Class="AutoPecasERP.Desktop.Views.EditarOsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ordem de Serviço" Width="1180" Height="760" WindowStartupLocation="CenterOwner" Background="#F4F6F8"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Titulo" FontSize="26" FontWeight="Bold" Foreground="#123B52"/><Grid Grid.Row="1" Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ClienteTxt" FontWeight="Bold"/><TextBlock x:Name="VeiculoTxt"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="StatusTxt" HorizontalAlignment="Right" FontWeight="Bold"/><TextBlock x:Name="TotalTxt" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold"/></StackPanel></Grid><TabControl Grid.Row="2"><TabItem Header="Peças"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="BuscaProduto" Width="360" Height="36" ToolTip="Código, código de barras ou descrição"/><TextBox x:Name="QtdPeca" Width="80" Height="36" Margin="8,0" Text="1"/><Button Content="Adicionar peça" Width="130" Click="Peca_Click"/></StackPanel><DataGrid x:Name="PecasGrid" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" AutoGenerateColumns="True"/></Grid></TabItem><TabItem Header="Serviços"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="ServicoDesc" Width="360" Height="36" ToolTip="Descrição do serviço"/><TextBox x:Name="QtdServico" Width="80" Height="36" Margin="8,0" Text="1"/><TextBox x:Name="ValorServico" Width="120" Height="36" Margin="0,0,8,0" ToolTip="Valor unitário"/><Button Content="Adicionar serviço" Width="140" Click="Servico_Click"/></StackPanel><DataGrid x:Name="ServicosGrid" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" AutoGenerateColumns="True"/></Grid></TabItem><TabItem Header="Diagnóstico"><TextBox x:Name="DiagnosticoBox" Margin="12" AcceptsReturn="True" TextWrapping="Wrap"/></TabItem></TabControl><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Salvar diagnóstico" Width="140" Click="Salvar_Click"/><Button Content="Finalizar OS" Width="130" Margin="10,0,0,0" Click="Finalizar_Click"/></StackPanel></Grid></Window>