<Window x:Class="AutoPecasERP.Desktop.Views.PdvProfissionalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PDV • Auto Peças Concorrente" Width="1400" Height="850" WindowStartupLocation="CenterOwner" Background="#F4F6F8" KeyDown="Window_KeyDown"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="PDV • Balcão" FontSize="28" FontWeight="Bold" Foreground="#123B52"/><TextBlock Text="F2 Produto   F4 Cliente   F8 Finalizar   DEL Remover" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel><Grid Grid.Row="1" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Cliente"/><ComboBox x:Name="ClienteBox" Height="38" DisplayMemberPath="Nome"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Vendedor"/><TextBox x:Name="VendedorBox" Height="38"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Forma de pagamento"/><ComboBox x:Name="PagamentoBox" Height="38"><ComboBoxItem Content="DINHEIRO"/><ComboBoxItem Content="PIX"/><ComboBoxItem Content="CARTAO"/><ComboBoxItem Content="BOLETO"/><ComboBoxItem Content="CREDITO"/></ComboBox></StackPanel></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="BuscaBox" Width="460" Height="40" ToolTip="Código, código de barras ou descrição" KeyDown="Busca_KeyDown"/><TextBox x:Name="QtdBox" Width="80" Height="40" Margin="8,0" Text="1"/><Button Content="Adicionar" Width="110" Click="Adicionar_Click"/></StackPanel><DataGrid x:Name="CarrinhoGrid" Grid.Row="1" Margin="0,12,12,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120"/><DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/><DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade}" Width="80"/><DataGridTextColumn Header="Unitário" Binding="{Binding Unitario,StringFormat=C}" Width="110"/><DataGridTextColumn Header="Desc." Binding="{Binding Desconto,StringFormat=C}" Width="100"/><DataGridTextColumn Header="Total" Binding="{Binding Total,StringFormat=C}" Width="120"/></DataGrid.Columns></DataGrid></Grid><Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="Resumo da venda" FontSize="20" FontWeight="Bold"/><TextBlock Text="Subtotal" Margin="0,20,0,2"/><TextBlock x:Name="SubtotalTxt" Text="R$ 0,00" FontSize="20"/><TextBlock Text="Desconto da venda" Margin="0,16,0,2"/><TextBox x:Name="DescontoBox" Height="38" Text="0" LostFocus="Desconto_LostFocus"/><Separator Margin="0,20"/><TextBlock Text="TOTAL"/><TextBlock x:Name="TotalTxt" Text="R$ 0,00" FontSize="34" FontWeight="Bold" Foreground="#123B52"/><Button Content="REMOVER ITEM" Height="42" Margin="0,28,0,0" Click="Remover_Click"/><Button Content="FINALIZAR VENDA  F8" Height="56" Margin="0,10,0,0" FontWeight="Bold" Click="Finalizar_Click"/></StackPanel></Border></Grid><TextBlock Grid.Row="3" Text="A venda só é concluída após validação de estoque e transação do sistema." Margin="0,12,0,0"/></Grid></Window>