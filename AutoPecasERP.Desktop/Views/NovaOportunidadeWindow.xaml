<Window x:Class="AutoPecasERP.Desktop.Views.NovaOportunidadeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nova oportunidade" Width="650" Height="570" WindowStartupLocation="CenterOwner" Background="#F4F6F8"><StackPanel Margin="28"><TextBlock Text="Nova oportunidade" FontSize="26" FontWeight="Bold" Foreground="#123B52"/><TextBlock Text="Cliente (opcional)" Margin="0,18,0,4"/><ComboBox x:Name="ClienteBox" Height="34" DisplayMemberPath="Nome" SelectionChanged="Cliente_Changed"/><TextBlock Text="Contato" Margin="0,10,0,4"/><TextBox x:Name="ContatoBox" Height="34"/><TextBlock Text="Telefone / WhatsApp" Margin="0,10,0,4"/><TextBox x:Name="TelefoneBox" Height="34"/><TextBlock Text="Assunto" Margin="0,10,0,4"/><TextBox x:Name="AssuntoBox" Height="34"/><TextBlock Text="Valor estimado" Margin="0,10,0,4"/><TextBox x:Name="ValorBox" Height="34"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancelar" Width="100" Height="38" IsCancel="True"/><Button Content="Salvar" Width="110" Height="38" Margin="10,0,0,0" Click="Salvar_Click"/></StackPanel></StackPanel></Window>