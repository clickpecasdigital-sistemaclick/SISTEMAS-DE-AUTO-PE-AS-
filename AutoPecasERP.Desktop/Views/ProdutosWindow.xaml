<Window x:Class="AutoPecasERP.Desktop.Views.ProdutosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Produtos" Width="1250" Height="700" WindowStartupLocation="CenterOwner"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Produtos / Autopeças" FontSize="28" FontWeight="Bold"/><TextBox x:Name="Busca" Width="330" TextChanged="Busca_TextChanged"/></DockPanel><DataGrid x:Name="GridDados" Grid.Row="1" Margin="0,15" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding CodigoInterno}" Width="110"/><DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="2*"/><DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="*"/><DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="*"/><DataGridTextColumn Header="Local" Binding="{Binding Localizacao}" Width="90"/><DataGridTextColumn Header="Estoque" Binding="{Binding EstoqueAtual}" Width="90"/><DataGridTextColumn Header="Venda" Binding="{Binding PrecoVenda,StringFormat=C}" Width="110"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Novo produto" Width="120" Margin="4" Click="Novo_Click"/><Button Content="Movimentar estoque" Width="150" Margin="4" Click="Movimentar_Click"/></StackPanel></Grid></Window>