<Window x:Class="AutoPecasERP.Desktop.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Auto Peças Concorrente ERP" Width="980" Height="620" WindowStartupLocation="CenterScreen" Background="#EEF2F5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource Petroleo}"><StackPanel VerticalAlignment="Center" Margin="55"><TextBlock Text="AUTO PEÇAS" Foreground="White" FontSize="38" FontWeight="Bold"/><TextBlock Text="CONCORRENTE ERP" Foreground="#75C8FF" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Gestão integrada para distribuição automotiva" Foreground="#DCEAF2" FontSize="16" Margin="0,18,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="12" Margin="45" Padding="38"><StackPanel VerticalAlignment="Center"><TextBlock Text="Acesso ao sistema" FontSize="27" FontWeight="Bold" Foreground="#303840"/><TextBlock Text="Usuário" Margin="0,28,0,6"/><TextBox x:Name="UserBox" Height="38" Text="ADMIN"/><TextBlock Text="Senha" Margin="0,16,0,6"/><PasswordBox x:Name="PassBox" Height="38"/><TextBlock Text="Empresa" Margin="0,16,0,6"/><ComboBox Height="38" SelectedIndex="0"><ComboBoxItem Content="Auto Peças Concorrente"/></ComboBox><CheckBox Content="Lembrar usuário" Margin="0,16"/><Button Content="ENTRAR" Height="44" Background="{StaticResource TechBlue}" Foreground="White" FontWeight="Bold" Click="Entrar_Click"/><TextBlock x:Name="Msg" Foreground="{StaticResource AutomotiveRed}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid></Window>
