<Window x:Class="AutoPecasERP.Desktop.Views.ClientesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clientes" Width="1150" Height="700" WindowStartupLocation="CenterOwner" Background="#F4F6F8"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="Clientes" FontSize="28" FontWeight="Bold"/><TextBox x:Name="Busca" Width="320" Height="34" HorizontalAlignment="Right" TextChanged="Busca_TextChanged"/></DockPanel><DataGrid x:Name="GridDados" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*"/><DataGridTextColumn Header="CPF/CNPJ" Binding="{Binding CpfCnpj}" Width="*"/><DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="*"/><DataGridTextColumn Header="Cidade" Binding="{Binding Cidade}" Width="*"/><DataGridTextColumn Header="UF" Binding="{Binding Estado}" Width="70"/><DataGridTextColumn Header="Limite" Binding="{Binding LimiteCredito,StringFormat=C}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Novo" Width="100" Margin="4" Click="Novo_Click"/><Button Content="Excluir" Width="100" Margin="4" Click="Excluir_Click"/><Button Content="Atualizar" Width="100" Margin="4" Click="Atualizar_Click"/></StackPanel></Grid></Window>