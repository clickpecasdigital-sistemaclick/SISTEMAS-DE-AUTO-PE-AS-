<Window x:Class="AutoPecasERP.Desktop.Views.PdvWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PDV / Vendas" Width="1250" Height="760" WindowStartupLocation="CenterOwner" Background="#F4F6F8">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="PDV • Nova Venda" FontSize="28" FontWeight="Bold" Foreground="#123B52"/>
<Grid Grid.Row="1" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<ComboBox x:Name="ClienteBox" DisplayMemberPath="Nome" Margin="4" Height="38"/><TextBox x:Name="Busca" Grid.Column="1" Margin="4" Height="38" ToolTip="Código, código de barras ou descrição" KeyDown="Busca_KeyDown"/><ComboBox x:Name="PagamentoBox" Grid.Column="2" Margin="4" Height="38"/></Grid>
<DataGrid x:Name="GridItens" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110"/><DataGridTextColumn Header="Produto" Binding="{Binding Descricao}" Width="*"/><DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade}" Width="90"/><DataGridTextColumn Header="Unitário" Binding="{Binding ValorUnitario,StringFormat=C}" Width="120"/><DataGridTextColumn Header="Total" Binding="{Binding Total,StringFormat=C}" Width="130"/></DataGrid.Columns></DataGrid>
<DockPanel Grid.Row="3" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Desconto venda:" VerticalAlignment="Center"/><TextBox x:Name="DescontoBox" Width="110" Margin="8,0" Text="0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="TotalText" Text="TOTAL R$ 0,00" FontSize="24" FontWeight="Bold" Foreground="#123B52" VerticalAlignment="Center" Margin="20,0"/><Button Content="FINALIZAR VENDA  F6" Width="190" Height="48" Background="#1677C8" Foreground="White" Click="Finalizar_Click"/></StackPanel></DockPanel>
</Grid></Window>