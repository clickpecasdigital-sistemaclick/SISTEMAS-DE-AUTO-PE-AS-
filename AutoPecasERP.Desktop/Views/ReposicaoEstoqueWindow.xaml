<Window x:Class="AutoPecasERP.Desktop.Views.ReposicaoEstoqueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reposição de Estoque" Width="1180" Height="720" WindowStartupLocation="CenterOwner" Background="#F4F6F8"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Sugestão de Reposição" FontSize="28" FontWeight="Bold" Foreground="#123B52"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,10"><TextBox x:Name="BuscaBox" Width="320" Height="36" ToolTip="Código ou produto" TextChanged="Busca_Changed"/><Button Content="Atualizar" Width="100" Margin="8,0" Click="Atualizar_Click"/></StackPanel><DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120"/><DataGridTextColumn Header="Produto" Binding="{Binding Produto}" Width="*"/><DataGridTextColumn Header="Atual" Binding="{Binding EstoqueAtual}" Width="90"/><DataGridTextColumn Header="Mínimo" Binding="{Binding EstoqueMinimo}" Width="90"/><DataGridTextColumn Header="Máximo" Binding="{Binding EstoqueMaximo}" Width="90"/><DataGridTextColumn Header="Sugestão" Binding="{Binding Sugestao}" Width="100"/><DataGridTextColumn Header="Custo" Binding="{Binding Custo,StringFormat=C}" Width="110"/><DataGridTextColumn Header="Estimado" Binding="{Binding ValorEstimado,StringFormat=C}" Width="120"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="ResumoTxt" FontSize="18" FontWeight="Bold"/><Button Content="Abrir Compras" Width="130" DockPanel.Dock="Right" Click="Compras_Click"/></DockPanel></Grid></Window>