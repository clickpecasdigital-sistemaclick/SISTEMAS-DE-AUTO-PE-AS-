<Window x:Class="AutoPecasERP.Desktop.Views.FinanceiroWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Financeiro" Width="1100" Height="700" WindowStartupLocation="CenterOwner" Background="#F4F6F8"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Financeiro • Caixa e Contas a Receber" FontSize="28" FontWeight="Bold" Foreground="#123B52"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18"><Button Content="Abrir caixa" Width="120" Height="38" Click="Abrir_Click"/><Button Content="Suprimento" Width="120" Margin="8,0" Click="Suprimento_Click"/><Button Content="Sangria" Width="120" Click="Sangria_Click"/><Button Content="Fechar caixa" Width="120" Margin="8,0" Click="Fechar_Click"/><TextBlock x:Name="StatusCaixa" Margin="24,10" FontWeight="Bold"/></StackPanel><TabControl Grid.Row="2"><TabItem Header="Contas a receber"><DataGrid x:Name="ReceberGrid" AutoGenerateColumns="True" IsReadOnly="True" MouseDoubleClick="Receber_DoubleClick"/></TabItem><TabItem Header="Movimentos do caixa"><DataGrid x:Name="MovGrid" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem></TabControl></Grid></Window>