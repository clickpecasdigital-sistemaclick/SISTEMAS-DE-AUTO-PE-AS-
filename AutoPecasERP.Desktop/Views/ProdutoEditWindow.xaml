<Window x:Class="AutoPecasERP.Desktop.Views.ProdutoEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Novo produto" Width="650" Height="700" WindowStartupLocation="CenterOwner"><ScrollViewer><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.ColumnSpan="2" Text="Cadastro de produto" FontSize="26" FontWeight="Bold" Margin="0,0,0,18"/><StackPanel Grid.Row="1" Margin="4"><TextBlock Text="Código interno *"/><TextBox x:Name="Codigo"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="4"><TextBlock Text="Código fabricante"/><TextBox x:Name="Fabricante"/></StackPanel><StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="4"><TextBlock Text="Descrição *"/><TextBox x:Name="Descricao"/></StackPanel><StackPanel Grid.Row="3" Margin="4"><TextBlock Text="Marca"/><TextBox x:Name="Marca"/></StackPanel><StackPanel Grid.Row="3" Grid.Column="1" Margin="4"><TextBlock Text="Categoria"/><TextBox x:Name="Categoria"/></StackPanel><StackPanel Grid.Row="4" Margin="4"><TextBlock Text="NCM"/><TextBox x:Name="Ncm"/></StackPanel><StackPanel Grid.Row="4" Grid.Column="1" Margin="4"><TextBlock Text="Localização"/><TextBox x:Name="Local"/></StackPanel><StackPanel Grid.Row="5" Margin="4"><TextBlock Text="Custo"/><TextBox x:Name="Custo" Text="0"/></StackPanel><StackPanel Grid.Row="5" Grid.Column="1" Margin="4"><TextBlock Text="Preço venda"/><TextBox x:Name="Venda" Text="0"/></StackPanel><StackPanel Grid.Row="6" Margin="4"><TextBlock Text="Estoque mínimo"/><TextBox x:Name="Minimo" Text="0"/></StackPanel><StackPanel Grid.Row="6" Grid.Column="1" Margin="4"><TextBlock Text="Estoque máximo"/><TextBox x:Name="Maximo" Text="0"/></StackPanel><Button Grid.Row="7" Grid.ColumnSpan="2" Content="SALVAR PRODUTO" Height="42" Margin="4,22" Click="Salvar_Click"/></Grid></ScrollViewer></Window>