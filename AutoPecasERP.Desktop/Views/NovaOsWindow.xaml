<Window x:Class="AutoPecasERP.Desktop.Views.NovaOsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nova Ordem de Serviço" Width="760" Height="650" WindowStartupLocation="CenterOwner" Background="#F4F6F8"><ScrollViewer><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Nova Ordem de Serviço" FontSize="26" FontWeight="Bold" Foreground="#123B52"/><StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="Cliente"/><ComboBox x:Name="ClienteBox" DisplayMemberPath="Nome" Height="34" SelectionChanged="Cliente_Changed"/></StackPanel><StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Veículo"/><ComboBox x:Name="VeiculoBox" Height="34"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Marca}"/><Run Text=" "/><Run Text="{Binding Modelo}"/><Run Text=" • "/><Run Text="{Binding Placa}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Cadastrar veículo" Margin="0,6,0,0" Width="130" HorizontalAlignment="Left" Click="NovoVeiculo_Click"/></StackPanel><Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="KM"/><TextBox x:Name="KmBox" Height="34"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Mecânico"/><TextBox x:Name="MecanicoBox" Height="34"/></StackPanel></Grid><StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="Problema relatado"/><TextBox x:Name="ProblemaBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel><StackPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock Text="Diagnóstico inicial"/><TextBox x:Name="DiagnosticoBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel><StackPanel Grid.Row="6" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Width="100" Height="38" IsCancel="True"/><Button Content="Criar OS" Width="120" Height="38" Margin="10,0,0,0" Click="Salvar_Click"/></StackPanel></Grid></ScrollViewer></Window>